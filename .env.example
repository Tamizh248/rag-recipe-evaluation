# LLM provider configuration
# LLM_PROVIDER selects the generation backend:
#   "local" (default) - deterministic, extractive, no API key needed. Used for
#                        reproducible offline grounding/citation/refusal demos.
#   "anthropic"        - real Claude model via the Anthropic API. Requires LLM_API_KEY.
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector store
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Retrieval
TOP_K=5

# Chunking - current (baseline) chunker
# NOTE: 250/50 is deliberately small enough that the baseline chunker's
# fixed-size windows sometimes split an ingredient row away from its table
# header/recipe title (see results.md "Embarrassing Retrieval" + chunking
# decision sections for the measured effect of this).
CURRENT_CHUNK_SIZE=250
CURRENT_CHUNK_OVERLAP=50

# CORS
CORS_ORIGINS=http://localhost:4200
